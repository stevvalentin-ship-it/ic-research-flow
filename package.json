{
  "name": "ic-research-flow",
  "private": true,
  "version": "3.1.0-browser.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.parallel.json && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run --maxWorkers=1",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.parallel.json --pretty false",
    "prebuild": "node scripts/copy-pdf-assets.mjs",
    "predev": "node scripts/copy-pdf-assets.mjs",
    "test:browser": "vitest run browser --maxWorkers=1"
  },
  "dependencies": {
    "@myriaddreamin/typst-ts-renderer": "0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "@pdf-lib/fontkit": "1.1.1",
    "d3": "^7.9.0",
    "dejavu-fonts-ttf": "2.37.3",
    "dexie": "^4.4.5",
    "jszip": "3.10.1",
    "katex": "0.16.11",
    "lucide-react": "^1.37.0",
    "minisearch": "^7.2.0",
    "paper-parallel-pdfjs": "npm:pdfjs-dist@4.10.38",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/d3": "^7.4.3",
    "@types/katex": "0.16.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "pdf-lib": "^1.17.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
